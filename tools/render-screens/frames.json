  "forbiddenPatterns": [
    "\\[EMAIL PRIVACIDAD\\]",
    "\\[URL POLÍTICA\\]",
    "\\[OPERADOR SOCIO",
    "\\[RESPONSABLE\\]",
    "\\[TELÉFONO GRATUITO\\]",
    "GhoFi",
    "#E8FF2A",
    "#D4F200",
    "Carrer de Mar",
    "aislad",
    "servidores",
    "separada",
    "copia cifrada",
    "instantánea de tu red"
  ],
  "literalReplacements": {
    "Carrer de Mar 12": "Calle Ejemplo 1"
  },
  "placeholderSanitize": {
    "legalBlockSelector": ".b-dp",
    "legalBlockText": "Consulta nuestra política de privacidad en la app.",
    "defaultBracketReplacement": "Ver condiciones",
    "exactReplacements": {
      "[RESPONSABLE]": "el responsable del tratamiento",
      "[EMAIL PRIVACIDAD]": "la sección de privacidad en la app",
      "[URL POLÍTICA]": "la política de privacidad en la app",
      "[OPERADOR SOCIO / ninguno]": "proveedores autorizados, si corresponde",
      "[TELÉFONO GRATUITO]": "atención en la app",
      "[PRINCIPALES SERVICIOS: p. ej. facturas y app accesibles, atención por texto, tarifas especiales]. Más detalles en [ENLACE].": "Servicios de accesibilidad y atención disponibles en la app.",
      "[MAIN SERVICES]. More details at [LINK].": "Servicios de accesibilidad y atención disponibles en la app.",
      "[ENLACE]": "Ver condiciones",
      "[LINK]": "Ver condiciones",
      "Carrer de Mar 12": "Calle Ejemplo 1"
    },
    "orderMovilReplacements": {
      "[RESPONSABLE]": "",
      "[DIRECCIÓN]": "",
      "[EMAIL]": "",
      "[TELÉFONO]": "",
      "[CONTACTO RECLAMACIONES]": "atención en la app",
      "[SMS INCLUIDOS]": "SMS incluidos",
      "[LÍMITE ROAMING UE]": "10",
      "[QUÉ PASA: velocidad reducida a X / X € por bono de Y GB]": "velocidad reducida al agotar datos",
      "[PRECIOS]": "tarifas en la app",
      "[ENLACE TARIFAS]": "la app",
      "[REMEDIOS SEGÚN CONTRATO: p. ej. resolución sin coste / compensación]": "resolución sin coste o compensación según contrato",
      "[PRINCIPALES SERVICIOS: p. ej. facturas y app accesibles, atención por texto, tarifas especiales]. Más detalles en [ENLACE].": "Facturas y app accesibles, atención por texto y tarifas especiales. Más detalles en la app.",
