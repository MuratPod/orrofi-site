  "forbiddenPatterns": [
    "\\[EMAIL PRIVACIDAD\\]",
    "\\[URL POLÍTICA\\]",
    "\\[OPERADOR SOCIO",
    "\\[RESPONSABLE\\]",
    "\\[TELÉFONO GRATUITO\\]",
    "GhoFi",
    "#E8FF2A",
    "#D4F200"
