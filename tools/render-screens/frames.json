      "[PRINCIPALES SERVICIOS: p. ej. facturas y app accesibles, atención por texto, tarifas especiales]. Más detalles en [ENLACE].": "Servicios de accesibilidad y atención disponibles en la app.",
      "[MAIN SERVICES]. More details at [LINK].": "Servicios de accesibilidad y atención disponibles en la app.",
      "[ENLACE]": "Ver condiciones",
      "[LINK]": "Ver condiciones"
    },
    "orderMovilReplacements": {
      "[RESPONSABLE]": "",
      "[DIRECCIÓN]": "",
      "[EMAIL]": "",
      "[TELÉFONO]": "",
      "[CONTACTO RECLAMACIONES]": "atención en la app",
      "[SMS INCLUIDOS]": "SMS incluidos",
      "[LÍMITE ROAMING UE]": "10",
      "[QUÉ PASA: velocidad reducida a X / X € por bono de Y GB]": "velocidad reducida al agotar datos",
      "[PRECIOS]": "tarifas en la app",
      "[ENLACE TARIFAS]": "la app",
      "[REMEDIOS SEGÚN CONTRATO: p. ej. resolución sin coste / compensación]": "resolución sin coste o compensación según contrato",
